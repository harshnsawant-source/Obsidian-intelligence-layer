# Orchestration lift benchmark cases. `signal` tags grader reliability:
#   objective = sandbox-executed code (ground truth) | numeric = single number
#   structural = schema/shape only | shallow = keyword presence (NOT quality)
# The trustworthy lift signal lives in the `objective` (Engineering) cases.
{"id": "engineering_latency", "category": "Engineering", "signal": "objective", "task": "Write a Python function parse_latency(text) that extracts float latencies in seconds. 'latency=1.23s' returns 1.23; 'latency=45.0ms' returns 0.045; returns None if none found. Return ONLY the markdown python block.", "grader": "code", "test": "assert parse_latency('latency=1.23s') == 1.23\nassert parse_latency('latency=45.0ms') == 0.045\nassert parse_latency('no pattern') is None\nprint('ok')"}
{"id": "engineering_dedupe", "category": "Engineering", "signal": "objective", "task": "Write a Python function dedupe(items) returning a new list with duplicates removed, preserving first-occurrence order. Return ONLY the markdown python block.", "grader": "code", "test": "assert dedupe([1,2,1,3,2]) == [1,2,3]\nassert dedupe([]) == []\nassert dedupe(['a','a','b']) == ['a','b']\nprint('ok')"}
{"id": "engineering_balanced", "category": "Engineering", "signal": "objective", "task": "Write a Python function is_balanced(s) returning True if the brackets ()[]{} in s are correctly balanced and nested, else False. Return ONLY the markdown python block.", "grader": "code", "test": "assert is_balanced('([]{})') is True\nassert is_balanced('([)]') is False\nassert is_balanced('') is True\nassert is_balanced('(') is False\nprint('ok')"}
{"id": "engineering_merge_intervals", "category": "Engineering", "signal": "objective", "task": "Write a Python function merge_intervals(intervals) that merges overlapping [start,end] intervals and returns them sorted by start. Return ONLY the markdown python block.", "grader": "code", "test": "assert merge_intervals([[1,3],[2,6],[8,10]]) == [[1,6],[8,10]]\nassert merge_intervals([[1,4],[4,5]]) == [[1,5]]\nassert merge_intervals([]) == []\nprint('ok')"}
